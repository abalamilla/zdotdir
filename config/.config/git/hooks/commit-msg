#!/bin/bash

commit_msg_file="$1"
commit_msg=$(head -n 1 "$commit_msg_file")
gitlab_remote_url=$(git config --get-regexp '^remote\..*\.url' | grep 'git@gitlab' | head -n1 | awk '{print $2}')
excluded_projects_file="$HOME/.config/git/commit-msg-excluded-projects"

# Check if this is an office repo (gitlab remote)
is_office_repo() {
  [[ -n "$gitlab_remote_url" ]]
}

# Projects excluded from commit message format validation (any message
# format accepted), matched as a fixed-string substring of the gitlab
# remote URL. One "group/project" path per line in:
#   ~/.config/git/commit-msg-excluded-projects
# Not stow-managed / not committed to this (public) repo, since entries
# would name internal projects - create the file locally per machine.
is_excluded_project() {
  [[ -z "$gitlab_remote_url" ]] && return 1
  [[ -s "$excluded_projects_file" ]] || return 1
  grep -qFf "$excluded_projects_file" <<< "$gitlab_remote_url"
}

# Validate CJPM prefix: CJPM-XXXXX where X is a digit
validate_cjpm_prefix() {
  local msg="$1"
  # Check if message starts with CJPM- followed by digits and colon
  if [[ $msg =~ ^CJPM-[0-9]+: || $msg =~ ^Code\ improvement: ]]; then
    return 0
  else
    return 1
  fi
}

if is_office_repo && ! is_excluded_project; then
  if ! validate_cjpm_prefix "$commit_msg"; then
    echo "❌ Office profile detected (gitlab remote)."
    echo "   Commit message must start with one of:"
    echo "     CJPM-XXXXX: <message>  (e.g. CJPM-1234: Fix login bug)"
    echo "     Code improvement: <message>"
    echo ""
    echo "   Current message: $commit_msg"
    exit 1
  fi
fi

exit 0
