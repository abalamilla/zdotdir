#!/usr/bin/env zsh
#MISE description="Authenticate to AWS account(s) and connect to one or more EKS clusters"
#MISE alias="eks"
#USAGE arg "[alias]..." var=#true help="One or more cluster aliases e.g. scusw2 mcusw1 (omit for interactive picker)"
#USAGE flag "--role <role>" help="awsenv role for every cluster, overriding the role from the clusters file"
#USAGE flag "--reason <reason>" help="Reason for credential request (default: access cluster <cluster>)"

CLUSTERS_FILE="${CJ_CLUSTERS_FILE:-$HOME/.config/cj/clusters.yaml}"

if [[ ! -f "$CLUSTERS_FILE" ]]; then
    print -u2 "Cluster config not found: $CLUSTERS_FILE"
    print -u2 "Source office_profile to generate it"
    exit 1
fi

# alias|account|cluster|region|role, one line per cluster
TABLE=$(yq e 'to_entries[] | .key as $account | .value[] | [.alias, $account, .cluster, .region, (.role // "")] | join("|")' "$CLUSTERS_FILE" | grep .)

ALIASES=()
if [[ -n "${usage_alias:-}" ]]; then
    ALIASES=(${=usage_alias})
else
    SELECTION=$(fzf --delimiter='|' --header="alias | account | cluster | region | role" <<< "$TABLE")
    [[ -z "$SELECTION" ]] && exit 0
    ALIASES=("${SELECTION%%|*}")
fi

fpath=("${MY_CONFIG_PATH:-$HOME/zdotdir}/env/functions" $fpath)
autoload -Uz eksctx

LAST_CREDS=""   # account|role of the credentials currently exported, to avoid re-vending per cluster
typeset -A BAD_CREDS   # account|role that awsenv already refused: skip its clusters instead of asking again
connect_one() {
    local alias_name=$1 line account cluster region role creds_out key
    line=$(grep -m1 "^${alias_name}|" <<< "$TABLE")
    if [[ -z "$line" ]]; then
        print -u2 "No cluster found with alias: $alias_name"
        return 1
    fi
    IFS='|' read -r _ account cluster region role <<< "$line"
    role="${usage_role:-$role}"

    key="$account|$role"
    if [[ -n "${BAD_CREDS[$key]:-}" ]]; then
        print -u2 "→ Skipping $cluster ($region): no credentials for $account"
        return 1
    fi
    if [[ "$LAST_CREDS" != "$key" ]]; then
        # Role from --role, else the per-cluster one in the clusters file; --refresh-credentials so cached creds with another role are replaced
        local awsenv_args=()
        [[ -n "$role" ]] && awsenv_args=(--role "$role" --refresh-credentials)
        print "→ Getting credentials for: $account"
        creds_out=$(awsenv "$account" "${awsenv_args[@]}" --reason "${usage_reason:-access cluster $cluster}" --export) || { BAD_CREDS[$key]=1; return 1 }
        eval "$creds_out"
        LAST_CREDS="$key"
    fi

    print "→ Connecting: $cluster ($region)"
    eksctx "$cluster" "$region"
}

FAILED=()
for a in "${ALIASES[@]}"; do
    connect_one "$a" || FAILED+=("$a")
done

if (( ${#FAILED} )); then
    print -u2 ""
    print -u2 "✗ Failed (${#FAILED}/${#ALIASES}): ${FAILED[*]}"
    print -u2 "  Likely the credentials are for the wrong account or role, or the alias is unknown"
    exit 1
fi
if (( ${#ALIASES} > 1 )); then
    print "✓ Connected ${#ALIASES} clusters"
fi
exit 0

# vim:ft=zsh
