{
  "permissions": {
    "allow": [
      "Bash(git fetch *)",
      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl logs *)",
      "Bash(kubectl explain *)",
      "Bash(kubectl top *)",
      "Bash(kubectl config get-contexts *)",
      "Bash(kubectl config current-context *)",
      "Bash(helm list *)",
      "Bash(helm get *)",
      "Bash(helm status *)",
      "Bash(helm history *)",
      "Bash(helm show *)",
      "Bash(helm search *)",
      "Bash(helm version *)",
      "Bash(aws * describe-*)",
      "Bash(aws * list-*)",
      "Bash(aws s3 ls *)",
      "Bash(aws sts get-*)",
      "Bash(awsenv *)"
    ],
    "deny": [
      "Read(~/.aws/credentials)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/config)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(glab mr create *)",
      "Bash(gh pr create *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl delete *)",
      "Bash(kubectl edit *)",
      "Bash(kubectl patch *)",
      "Bash(kubectl scale *)",
      "Bash(kubectl rollout *)",
      "Bash(kubectl exec *)",
      "Bash(helm install *)",
      "Bash(helm upgrade *)",
      "Bash(helm uninstall *)",
      "Bash(helm rollback *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(aws s3 rm *)",
      "Bash(aws s3 cp *)",
      "Bash(aws s3 mv *)",
      "Bash(aws s3 sync *)",
      "Bash(aws * delete-*)",
      "Bash(aws * terminate-*)"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "skillOverrides": {
    "grill-me": "on",
    "task": "on",
    "claude-api": "user-invocable-only",
    "update-config": "user-invocable-only",
    "loop": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "simplify": "user-invocable-only",
    "security-review": "user-invocable-only",
    "init": "user-invocable-only",
    "review": "user-invocable-only"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/kitty-claude-session.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/lint-on-edit.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "oh-my-posh claude --config ~/.config/oh-my-posh/claude.toml",
    "padding": 0
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "jdtls-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "coaching@abalamilla-plugins": true,
    "teach-kit@abalamilla-plugins": true
  },
  "extraKnownMarketplaces": {
    "abalamilla-plugins": {
      "source": {
        "source": "directory",
        "path": "/Users/aalamilla/claude-plugins"
      }
    }
  },
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "theme": "dark",
  "editorMode": "vim",
  "autoCompactEnabled": true,
  "fileCheckpointingEnabled": true
}
